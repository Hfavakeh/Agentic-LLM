# Build/runtime artifacts — keep the image small and the build context fast.
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Old run logs at repo root (hundreds of them).
Agent_optimization_*.log
*.log

# Historical output directories and aggregated analysis — regenerated at runtime.
# Note: `outputs-*/` does NOT match the plain `outputs/` dir, so list it too.
outputs-*/
outputs/
analysis/

# Model checkpoints & generated artifacts — never needed in the image, and the
# main cause of a multi-GB build context / hours-long `COPY . .` step.
*.pt
*.pth
*.ckpt
*.png
*.rar

# Reports / generated docs
*.docx
*.pdf
*.pptx
*.html

# Local tooling
.git/
.gitignore
.claude/
.vscode/
.idea/
node_modules/
.venv/
venv/

# Keep datasets (preprocessed-*.csv) — they ARE needed inside the image.
